# Turns binary files (fonts) into C arrays compiled into the executable,
# so the game never has to find asset files at run time.
#
#   embed_files(OUTPUT <file.c> FILES <symbol> <path> [<symbol> <path> ...])
function(embed_files)
  cmake_parse_arguments(EMB "" "OUTPUT" "FILES" ${ARGN})
  set(code "/* Generated by cmake/embed.cmake - do not edit. */\n")
  list(LENGTH EMB_FILES count)
  math(EXPR last "${count} - 1")
  foreach(i RANGE 0 ${last} 2)
    math(EXPR j "${i} + 1")
    list(GET EMB_FILES ${i} symbol)
    list(GET EMB_FILES ${j} path)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
    file(SIZE "${path}" size)
    string(APPEND code "const unsigned char ${symbol}[] = {\n${bytes}\n};\n")
    string(APPEND code "const unsigned int ${symbol}_size = ${size}u;\n")
  endforeach()
  file(WRITE "${EMB_OUTPUT}" "${code}")
endfunction()
